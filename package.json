{
  "name": "hypermail",
  "version": "0.1.3",
  "private": true,
  "description": "A keyboard-first, offline-first email client inspired by Superhuman.",
  "main": "dist-electron/main.js",
  "author": "Daniel Victorino",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:bundle\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron:bundle": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --watch --sourcemap",
    "dev:electron": "wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:brand": "pwsh -File ./scripts/build-brand-assets.ps1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --clean --sourcemap",
    "package:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.hypermail.desktop",
    "productName": "HyperMail",
    "artifactName": "HyperMail-${version}-${os}-${arch}.${ext}",
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "publish": [
        {
          "provider": "generic",
          "url": "https://updates.hypermail.invalid/windows",
          "channel": "latest"
        }
      ],
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HyperMail",
      "uninstallDisplayName": "HyperMail",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "HyperMail-${version}-portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
